# Database Configuration
DATABASE_URL=postgresql://talentpilot:talentpilot@localhost:5432/talentpilot

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# OpenAI API (for AI Tips and Embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Settings
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email / SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=twoj.email@gmail.com
SMTP_PASSWORD=twoje-haslo-aplikacyjne
SMTP_FROM_EMAIL=powiadomienia@twojadomena.pl
SMTP_FROM_NAME="Manager Copilot"

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Docker Compose Port Overrides
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:8000

# Integrations
TALENTPILOT_TEAM_URL=http://localhost:3001
EXTERNAL_API_KEY=shared-secret-key-123

# Billing — see docs/BILLING_STRIPE_SETUP.md for the full procedure.
# disabled | fake | stripe. "fake" is refused when ENVIRONMENT=production.
BILLING_PROVIDER=disabled
# Only for BILLING_PROVIDER=fake (signs the simulated webhooks).
BILLING_WEBHOOK_SECRET=

# Product-led trial: granted at registration, no card required.
BILLING_TRIAL_DAYS_DEFAULT=14
BILLING_TRIAL_DAYS_COACH=30
# true = ask for a card during signup instead of running the trial card-free.
BILLING_REQUIRE_CARD_AT_SIGNUP=false

# Stripe — test keys on staging, live keys on production. Price IDs come
# from the Stripe Dashboard; amounts are never stored in this repo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
